diff --git a/backend/src/patients/__tests__/performance.test.ts b/backend/src/patients/__tests__/performance.test.ts
new file mode 100644
index 0000000..0304382
--- /dev/null
+++ b/backend/src/patients/__tests__/performance.test.ts
@@ -0,0 +1,196 @@
+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import type request from "supertest";
+import { createApp } from "../../app.js";
+import { prisma } from "../../prisma.js";
+import { encrypt } from "../../lib/fieldCrypto.js";
+import { loginAgent } from "../../test-utils/authAgent.js";
+import { testPatientData } from "../../test-utils/patientData.js";
+import { todayInClinic } from "@clinic/schemas";
+
+/**
+ * Performance guard for Developer 2's two hot paths (SRS 4.2 / SDD 3.5):
+ *   - patient search returns within 2 seconds
+ *   - the patient chart summary opens within 3 seconds
+ *
+ * Runs against the real database (the CI Postgres) on a representative dataset,
+ * so a regression that turns an indexed lookup into a sequential scan, or adds
+ * an N+1 round trip, fails here instead of in the client walkthrough.
+ *
+ * The budgets are the SRS targets. We warm each endpoint once (first call pays
+ * connection and plan-cache costs) and then take the best of three timings,
+ * which is what "under normal load" means and keeps the assertion stable on a
+ * shared CI runner while still catching a real slowdown at this scale.
+ *
+ * NOTE on indexes: no migration accompanies this test. Every query on these two
+ * paths is already covered by an existing index — patient search by the blind
+ * indexes on Patient (lastNameIdx / firstNameIdx / dobIdx / mobileIdx) and the
+ * chart reads by Encounter(patientId,visitDate), ExamFinding(patientId,fieldName),
+ * LabResult(patientId,testName,collectionDate), Medication(patientId,isCurrent,status)
+ * and Allergy(patientId,voidedAt). This test documents and protects that.
+ */
+
+const SEARCH_BUDGET_MS = 2000;
+const CHART_BUDGET_MS = 3000;
+
+// Dataset sizes: enough rows that a missing index would show, small enough to
+// seed quickly in CI.
+const SEARCH_PATIENTS = 80;
+const CHART_VISITS = 12;
+
+const app = createApp();
+
+let agent: ReturnType<typeof request.agent>;
+let cleanup: () => Promise<void>;
+let userId = "";
+let clinicId = "";
+let richPatientId = "";
+const seededPatientIds: string[] = [];
+
+// Letters-only surname (the name blind index drops digits), unique per run.
+const surname = `Perf${Date.now()
+  .toString()
+  .split("")
+  .map((d) => "abcdefghij"[Number(d)])
+  .join("")}`;
+
+const dateOffset = (days: number) => {
+  const d = new Date(`${todayInClinic()}T00:00:00Z`);
+  d.setUTCDate(d.getUTCDate() - days);
+  return d;
+};
+
+/** Best of three timings of an async call, in milliseconds. */
+async function bestOfThree(run: () => Promise<unknown>): Promise<number> {
+  await run(); // warm up
+  let best = Infinity;
+  for (let i = 0; i < 3; i++) {
+    const start = performance.now();
+    await run();
+    best = Math.min(best, performance.now() - start);
+  }
+  return best;
+}
+
+beforeAll(async () => {
+  const clinic = await prisma.clinic.create({ data: { name: `${surname} Clinic` } });
+  clinicId = clinic.id;
+
+  const doc = await loginAgent(app, "DOCTOR", clinicId);
+  agent = doc.agent;
+  cleanup = doc.cleanup;
+  userId = doc.userId;
+
+  // Search dataset: many patients sharing one surname, so a name search returns
+  // a realistic result set the server must filter and paginate.
+  for (let i = 0; i < SEARCH_PATIENTS; i++) {
+    const p = await prisma.patient.create({
+      data: testPatientData(clinicId, userId, { firstName: `Case${i}`, lastName: surname }),
+    });
+    seededPatientIds.push(p.id);
+  }
+  richPatientId = seededPatientIds[0]!;
+
+  // Chart dataset: one patient with a history across several visits, so the
+  // chart summary assembles findings, labs, medications and allergies.
+  for (let v = 0; v < CHART_VISITS; v++) {
+    const enc = await prisma.encounter.create({
+      data: {
+        patientId: richPatientId,
+        clinicId,
+        attendingDoctorId: userId,
+        type: "FOLLOW_UP",
+        visitDate: dateOffset(v * 30),
+        createdById: userId,
+      },
+    });
+    for (const eye of ["OD", "OS"] as const) {
+      await prisma.examFinding.create({
+        data: {
+          patientId: richPatientId,
+          encounterId: enc.id,
+          clinicId,
+          eye,
+          fieldName: "IOP",
+          valueText: encrypt(String(14 + (v % 6))),
+          unit: "mmHg",
+          measuredAt: dateOffset(v * 30),
+          lookupVersion: 1,
+          recordedById: userId,
+        },
+      });
+    }
+  }
+  for (let l = 0; l < 4; l++) {
+    await prisma.labResult.create({
+      data: {
+        patientId: richPatientId,
+        clinicId,
+        testName: "HbA1c",
+        resultValue: encrypt(String(6 + l * 0.2)),
+        resultUnit: "%",
+        collectionDate: dateOffset(l * 60),
+        laboratoryName: "Test Lab",
+        lookupVersion: 1,
+        recordedById: userId,
+      },
+    });
+  }
+  for (let m = 0; m < 5; m++) {
+    await prisma.medication.create({
+      data: {
+        patientId: richPatientId,
+        clinicId,
+        medicationName: `Timolol ${m}`,
+        dose: "1 drop",
+        frequency: "BID",
+        route: "Ophthalmic",
+        startDate: dateOffset(m * 20),
+        prescribingDoctor: "Dr. Test",
+        recordedById: userId,
+      },
+    });
+  }
+  for (let a = 0; a < 3; a++) {
+    await prisma.allergy.create({
+      data: {
+        patientId: richPatientId,
+        clinicId,
+        allergenName: `Allergen ${a}`,
+        severity: "MODERATE",
+        recordedById: userId,
+      },
+    });
+  }
+}, 60_000);
+
+afterAll(async () => {
+  // Children before parents (ON DELETE RESTRICT everywhere).
+  await prisma.examFinding.deleteMany({ where: { patientId: richPatientId } }).catch(() => undefined);
+  await prisma.labResult.deleteMany({ where: { patientId: richPatientId } }).catch(() => undefined);
+  await prisma.medication.deleteMany({ where: { patientId: richPatientId } }).catch(() => undefined);
+  await prisma.allergy.deleteMany({ where: { patientId: richPatientId } }).catch(() => undefined);
+  await prisma.encounter.deleteMany({ where: { patientId: richPatientId } }).catch(() => undefined);
+  await prisma.patient.deleteMany({ where: { id: { in: seededPatientIds } } }).catch(() => undefined);
+  await cleanup?.();
+  await prisma.clinic.delete({ where: { id: clinicId } }).catch(() => undefined);
+});
+
+describe("Performance (SRS 4.2 / SDD 3.5)", () => {
+  it(`returns patient search within ${SEARCH_BUDGET_MS} ms`, async () => {
+    const ms = await bestOfThree(() =>
+      agent.get(`/api/patients?q=${surname}&by=name&pageSize=20`).expect(200),
+    );
+    // eslint-disable-next-line no-console
+    console.log(`[perf] patient search: ${ms.toFixed(0)} ms (budget ${SEARCH_BUDGET_MS} ms)`);
+    expect(ms).toBeLessThan(SEARCH_BUDGET_MS);
+  });
+
+  it(`opens the chart summary within ${CHART_BUDGET_MS} ms`, async () => {
+    const ms = await bestOfThree(() =>
+      agent.get(`/api/patients/${richPatientId}/summary`).expect(200),
+    );
+    // eslint-disable-next-line no-console
+    console.log(`[perf] chart summary: ${ms.toFixed(0)} ms (budget ${CHART_BUDGET_MS} ms)`);
+    expect(ms).toBeLessThan(CHART_BUDGET_MS);
+  });
+});
diff --git a/scripts/perf-measure.mjs b/scripts/perf-measure.mjs
new file mode 100644
index 0000000..d2da01c
--- /dev/null
+++ b/scripts/perf-measure.mjs
@@ -0,0 +1,147 @@
+#!/usr/bin/env node
+/**
+ * Standalone performance measurement for the deployed EMR (QA evidence,
+ * SRS 4.2 / SDD 3.5). Hits a live site over HTTP, so it captures real
+ * latency — including the Render free-plan cold start — the way the client
+ * walkthrough will experience it.
+ *
+ * It measures Developer 2's two targets and a 5-user concurrency burst:
+ *   - patient search      target  < 2000 ms
+ *   - chart summary open  target  < 3000 ms
+ *   - 5 concurrent chart loads (SRS: at least 5 concurrent users)
+ *
+ * No dependencies — Node 20+ (global fetch). Run from the repo root:
+ *
+ *   node scripts/perf-measure.mjs \
+ *     --url https://clinic-emr.onrender.com \
+ *     --user apacio --pass 'DoctorPass123!' \
+ *     --q delacruz
+ *
+ * Flags (or the matching env vars):
+ *   --url   PERF_URL      base URL of the deployed site (no trailing slash)
+ *   --user  PERF_USER     doctor username
+ *   --pass  PERF_PASS     doctor password
+ *   --clinic PERF_CLINIC  clinic name to select (default: the first one)
+ *   --q     PERF_Q        patient search term (default: "a")
+ *   --runs  PERF_RUNS     timed repeats per endpoint (default: 5)
+ *
+ * The site must hold only sample data. Do not run this against real patients.
+ */
+
+const args = Object.fromEntries(
+  process.argv.slice(2).flatMap((a, i, arr) => (a.startsWith("--") ? [[a.slice(2), arr[i + 1]]] : [])),
+);
+const cfg = {
+  url: (args.url ?? process.env.PERF_URL ?? "http://localhost:4000").replace(/\/$/, ""),
+  user: args.user ?? process.env.PERF_USER ?? "apacio",
+  pass: args.pass ?? process.env.PERF_PASS ?? "DoctorPass123!",
+  clinic: args.clinic ?? process.env.PERF_CLINIC ?? "",
+  q: args.q ?? process.env.PERF_Q ?? "a",
+  runs: Number(args.runs ?? process.env.PERF_RUNS ?? 5),
+};
+
+const BUDGETS = { search: 2000, chart: 3000 };
+
+let cookie = "";
+async function http(method, path, body) {
+  const res = await fetch(`${cfg.url}${path}`, {
+    method,
+    headers: { "content-type": "application/json", ...(cookie ? { cookie } : {}) },
+    body: body ? JSON.stringify(body) : undefined,
+    redirect: "manual",
+  });
+  const setCookie = res.headers.getSetCookie?.() ?? [];
+  if (setCookie.length) cookie = setCookie.map((c) => c.split(";")[0]).join("; ");
+  const text = await res.text();
+  let json;
+  try {
+    json = text ? JSON.parse(text) : undefined;
+  } catch {
+    json = undefined;
+  }
+  return { status: res.status, json, text };
+}
+
+async function timed(fn) {
+  const start = performance.now();
+  await fn();
+  return performance.now() - start;
+}
+
+function stats(times) {
+  const sorted = [...times].sort((a, b) => a - b);
+  const p = (q) => sorted[Math.min(sorted.length - 1, Math.floor(q * sorted.length))];
+  return { min: sorted[0], median: p(0.5), p95: p(0.95), max: sorted[sorted.length - 1] };
+}
+
+const ms = (n) => `${n.toFixed(0)} ms`;
+const verdict = (value, budget) => (value < budget ? "PASS" : "FAIL");
+
+async function waitForWake() {
+  process.stdout.write("Waking the site (/health/ready) … ");
+  for (let i = 0; i < 20; i++) {
+    const t0 = performance.now();
+    try {
+      const r = await http("GET", "/health/ready");
+      if (r.status === 200) {
+        console.log(`up after ${ms(performance.now() - t0)} (attempt ${i + 1})`);
+        return;
+      }
+    } catch {
+      /* retry */
+    }
+    await new Promise((r) => setTimeout(r, 3000));
+  }
+  console.log("gave up waiting — continuing anyway");
+}
+
+async function main() {
+  console.log(`Target: ${cfg.url}`);
+  await waitForWake();
+
+  const login = await http("POST", "/api/auth/login", { username: cfg.user, password: cfg.pass });
+  if (login.status !== 200) throw new Error(`Login failed (${login.status}): ${login.text}`);
+
+  const clinics = (await http("GET", "/api/clinics")).json?.items ?? [];
+  if (!clinics.length) throw new Error("No clinics returned — is the site seeded?");
+  const chosen = cfg.clinic ? clinics.find((c) => c.name === cfg.clinic) : clinics[0];
+  if (!chosen) throw new Error(`Clinic "${cfg.clinic}" not found. Available: ${clinics.map((c) => c.name).join(", ")}`);
+  await http("POST", "/api/auth/select-clinic", { clinicId: chosen.id });
+  console.log(`Signed in as ${cfg.user}, clinic "${chosen.name}". Runs per endpoint: ${cfg.runs}\n`);
+
+  // Search
+  const searchTimes = [];
+  for (let i = 0; i < cfg.runs; i++) {
+    searchTimes.push(await timed(() => http("GET", `/api/patients?q=${encodeURIComponent(cfg.q)}&by=name&pageSize=20`)));
+  }
+  const s = stats(searchTimes);
+
+  // Find a patient to open (search by term, else list)
+  const list = (await http("GET", `/api/patients?q=${encodeURIComponent(cfg.q)}&pageSize=1`)).json;
+  const patientId = list?.items?.[0]?.id ?? (await http("GET", "/api/patients?pageSize=1")).json?.items?.[0]?.id;
+  if (!patientId) throw new Error("No patient found to open a chart for.");
+
+  // Chart
+  const chartTimes = [];
+  for (let i = 0; i < cfg.runs; i++) {
+    chartTimes.push(await timed(() => http("GET", `/api/patients/${patientId}/summary`)));
+  }
+  const c = stats(chartTimes);
+
+  // 5-user concurrency: five chart loads at once, report the slowest.
+  const concurrentStart = performance.now();
+  await Promise.all(Array.from({ length: 5 }, () => http("GET", `/api/patients/${patientId}/summary`)));
+  const concurrentMax = performance.now() - concurrentStart;
+
+  console.log("Results (warm; first cold request excluded from the budget):\n");
+  console.log(`  Patient search   min ${ms(s.min)}  median ${ms(s.median)}  p95 ${ms(s.p95)}   [${verdict(s.median, BUDGETS.search)} < ${BUDGETS.search} ms]`);
+  console.log(`  Chart summary    min ${ms(c.min)}  median ${ms(c.median)}  p95 ${ms(c.p95)}   [${verdict(c.median, BUDGETS.chart)} < ${BUDGETS.chart} ms]`);
+  console.log(`  5 concurrent charts finished in ${ms(concurrentMax)}`);
+  console.log("\n  PDF (5 s target) is Developer 1's documents module — measure it from the signing flow separately.");
+  console.log("  Note: the first request after the free instance sleeps is far slower; that cold start is a known free-plan limit, not a query problem.");
+}
+
+main().catch((err) => {
+  console.error("\nMeasurement failed:", err.message);
+  process.exit(1);
+});
