# Copy to `.env` and adjust for your machine.

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL="postgresql://clinic:clinic@localhost:5432/clinic?schema=public"

# Redis (sessions, BullMQ)
REDIS_URL="redis://localhost:6379"

# HTTP
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# Sessions. SESSION_SECRET must be a long random string in production (32+ chars).
# For local dev, any non-empty value works. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="dev-secret-change-me-in-production-only-for-local-use"
SESSION_COOKIE_NAME="clinic.sid"

# Patient field encryption (Dev 2). Two DIFFERENT 32-byte keys, base64. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing FIELD_ENCRYPTION_KEY makes stored patient data unreadable; back it up.
# Both are REQUIRED and must differ from each other. The server refuses to
# start without them. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=""
BLIND_INDEX_KEY=""
SESSION_IDLE_TIMEOUT_MINUTES=30

# S3-compatible object storage (matches the MinIO service in docker-compose.yml)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="clinic-documents"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"

# Puppeteer — leave empty to use the bundled Chromium.
# PUPPETEER_EXECUTABLE_PATH=

# Reminders (BullMQ). SMS is a test stub until an SMS provider is chosen.
REMINDERS_ENABLED=true
CLINIC_TIMEZONE="Asia/Manila"
REMINDER_SCAN_CRON="0 8 * * *"
REMINDER_LEAD_DAYS=2
REMINDER_JOB_ATTEMPTS=5
REMINDER_JOB_BACKOFF_MS=30000
UNREACHABLE_AFTER_ATTEMPTS=3
SMS_PROVIDER=stub
# stub only logs email. Set EMAIL_PROVIDER=smtp to send it to Mailpit
# (docker-compose.yml) and read it at http://localhost:8025.
SMTP_URL="smtp://localhost:1025"
EMAIL_FROM="Clinic <no-reply@clinic.local>"
EMAIL_PROVIDER=stub

# Field encryption key for sensitive columns (prisma-field-encryption).
# Generate with: node -e "console.log('k1.aesgcm256.' + require('crypto').randomBytes(32).toString('base64'))"
# Rotation is supported via k2, k3 keys separated by commas (see library docs).
PRISMA_FIELD_ENCRYPTION_KEY="k1.aesgcm256.CHANGE-ME-IN-PRODUCTION-RUN-GENERATOR-ABOVE-abcdefghijklmnopqr=="

# Doctor-approved medication / allergen reference for the safety check (JSON, same
# shape as src/medications/drugReferenceData.ts). Unset = bundled starter list.
# DRUG_REFERENCE_PATH="/app/config/drug-reference.json"

# ---- Background jobs (BullMQ): report exports, backups, retention purges ----
BACKGROUND_JOBS_ENABLED=true
# Daily database backup and retention purge (cron, in CLINIC_TIMEZONE).
BACKUP_CRON="0 2 * * *"
PURGE_CRON="30 3 * * *"
BACKUP_RETENTION_DAYS=30
AUDIT_RETENTION_YEARS=5
REPORT_EXPORT_RETENTION_DAYS=7
# Backups go to a separate bucket/location and are encrypted with this key:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BACKUP_S3_BUCKET="clinic-backups"
BACKUP_ENCRYPTION_KEY=""
# BACKUP_S3_ENDPOINT= BACKUP_S3_REGION= BACKUP_S3_ACCESS_KEY_ID= BACKUP_S3_SECRET_ACCESS_KEY=
# pg_dump must match the server's major version (the Docker image installs 16).
PG_DUMP_PATH="pg_dump"

# ---- SMS provider (stub until the clinic chooses one) ----
# SMS_PROVIDER=twilio  needs TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN and TWILIO_FROM (or TWILIO_MESSAGING_SERVICE_SID)
# SMS_PROVIDER=semaphore  needs SEMAPHORE_API_KEY (and optionally SEMAPHORE_SENDER_NAME)
# PUBLIC_BASE_URL is where the provider posts delivery reports (/api/webhooks/sms/...).
# PUBLIC_BASE_URL="https://emr.example.com"
# SMS_WEBHOOK_SECRET=
