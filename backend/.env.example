# Copy to `.env` and adjust for your machine.

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL="postgresql://clinic:clinic@localhost:5432/clinic?schema=public"

# Redis (sessions, BullMQ)
REDIS_URL="redis://localhost:6379"

# HTTP
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# Sessions. SESSION_SECRET must be a long random string in production (32+ chars).
# For local dev, any non-empty value works. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="dev-secret-change-me-in-production-only-for-local-use"
SESSION_COOKIE_NAME="clinic.sid"
SESSION_IDLE_TIMEOUT_MINUTES=30

# S3-compatible object storage (matches the MinIO service in docker-compose.yml)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="clinic-documents"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"

# Puppeteer — leave empty to use the bundled Chromium.
# PUPPETEER_EXECUTABLE_PATH=

# Reminders (BullMQ). Gateways are test stubs until an SMS/email provider is chosen.
REMINDERS_ENABLED=true
CLINIC_TIMEZONE="Asia/Manila"
REMINDER_SCAN_CRON="0 8 * * *"
REMINDER_LEAD_DAYS=2
REMINDER_JOB_ATTEMPTS=5
REMINDER_JOB_BACKOFF_MS=30000
UNREACHABLE_AFTER_ATTEMPTS=3
SMS_PROVIDER=stub
EMAIL_PROVIDER=stub

# Field encryption key for sensitive columns (prisma-field-encryption).
# Generate with: node -e "console.log('k1.aesgcm256.' + require('crypto').randomBytes(32).toString('base64'))"
# Rotation is supported via k2, k3 keys separated by commas (see library docs).
PRISMA_FIELD_ENCRYPTION_KEY="k1.aesgcm256.CHANGE-ME-IN-PRODUCTION-RUN-GENERATOR-ABOVE-abcdefghijklmnopqr=="