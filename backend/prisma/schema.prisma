// Prisma schema — clinic management system.
//
// Developer 1 owns: Clinic, ClinicSchedule, Appointment, Document, DocumentRequest.
// Developer 2 owns: Patient (full model below).
// User (Dev 4) is still a placeholder; keep its `id` stable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================ Patients (Dev 2) ===============================

enum Sex {
  MALE
  FEMALE
}

/// Shared patient chart (data dictionary 1.4.4).
///
/// Fields commented "app-encrypted" hold AES-256-GCM ciphertext written by
/// src/lib/fieldCrypto.ts, never plaintext. Do NOT add the prisma-field-encryption
/// tag to these fields, or they will be encrypted twice. Because ciphertext cannot be
/// searched, each searchable field also has a keyed HMAC "blind index"
/// (*Idx columns). Search and duplicate detection run on those indexes.
/// Blind indexes support exact matches only (after normalisation), not
/// partial matches.
model Patient {
  id                 String @id @default(cuid())
  /// Sequential number shown as "P-00231". Never reused.
  patientSeq         Int    @unique @default(autoincrement())
  registeredClinicId String

  firstName   String // app-encrypted
  middleName  String? // app-encrypted
  lastName    String // app-encrypted
  dateOfBirth String // app-encrypted (ISO date "YYYY-MM-DD")
  sex         Sex
  civilStatus String?
  occupation  String? // app-encrypted

  mobileNumber          String // app-encrypted
  alternatePhone        String? // app-encrypted
  email                 String? // app-encrypted
  address               String? // app-encrypted
  emergencyContactName  String? // app-encrypted
  emergencyContactPhone String? // app-encrypted

  hmoProvider      String?
  hmoMemberNumber  String? // app-encrypted
  hmoValidUntil    DateTime? @db.Date
  philhealthNumber String? // app-encrypted
  referralSource   String?

  /// Doctor-only, from supervised intake.
  medicalHistory    String? // app-encrypted
  ophthalmicHistory String? // app-encrypted

  // Blind indexes (HMAC-SHA256 hex of the normalised value)
  firstNameIdx String
  lastNameIdx  String
  dobIdx       String
  mobileIdx    String

  voidedAt    DateTime?
  voidReason  String?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  registeredClinic Clinic @relation("PatientRegisteredClinic", fields: [registeredClinicId], references: [id], onDelete: Restrict)
  createdBy        User   @relation("PatientCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  appointments     Appointment[]
  documents        Document[]
  images           ClinicalImage[]
  documentRequests DocumentRequest[]
  consents         PatientConsent[]
  followUps        FollowUp[]
  outreachLogs     OutreachLog[]
  medications      Medication[]
  allergies        Allergy[]

  tabletIntakeSubmissions TabletIntakeSubmission[]

  @@index([lastNameIdx])
  @@index([firstNameIdx])
  @@index([dobIdx, lastNameIdx])
  @@index([mobileIdx])
  @@index([registeredClinicId])
}

/// Staff account. Only the Doctor can approve, change, revoke accounts and the
/// clinics each account may work in (see UserClinic).
model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  fullName            String
  passwordHash        String
  role                UserRole   @default(SECRETARY)
  status              UserStatus @default(PENDING)
  // Lockout tracking per SRS 7.2: 5 failed attempts within 15 min locks the account.
  failedLoginAttempts Int        @default(0)
  firstFailedLoginAt  DateTime?
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  documentRequests   DocumentRequest[]
  clinics            UserClinic[]
  appointmentEvents  AppointmentEvent[]
  walkInsApproved    Appointment[]      @relation("WalkInApprovedBy")
  documentDeliveries DocumentDelivery[]
  uploadedImages     ClinicalImage[]
  createdAnnotations ImageAnnotation[]
  documentsSigned    Document[]         @relation("DocumentSignedBy")
  documentsSent      Document[]         @relation("DocumentSentBy")

  consentsRecorded    PatientConsent[] @relation("ConsentRecordedBy")
  consentsWithdrawn   PatientConsent[] @relation("ConsentWithdrawnBy")
  followUpsCreated    FollowUp[]       @relation("FollowUpCreatedBy")
  followUpsCompleted  FollowUp[]       @relation("FollowUpCompletedBy")
  outreachLogs        OutreachLog[]
  medicationsRecorded Medication[]
  allergiesRecorded   Allergy[]
  patientsCreated     Patient[]        @relation("PatientCreatedBy")

  startedTabletSessions TabletIntakeSession[] @relation("TabletIntakeSessionStarter")

  @@index([status])
  @@index([role])
}

enum UserRole {
  DOCTOR
  SECRETARY
}

enum UserStatus {
  PENDING
  ACTIVE
  LOCKED
  REVOKED
  REJECTED
}

// ================================ Clinic (Dev 1) =============================

model Clinic {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  email     String?
  timezone  String   @default("Asia/Manila")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedules          ClinicSchedule[]
  staff              UserClinic[]
  appointments       Appointment[]
  documents          Document[]
  documentRequests   DocumentRequest[]
  followUps          FollowUp[]
  outreachLogs       OutreachLog[]
  medications        Medication[]
  allergies          Allergy[]
  patientsRegistered Patient[]         @relation("PatientRegisteredClinic")

  tabletSessions TabletIntakeSession[]

  @@index([isActive])
}

/// One operating-hours window for a clinic on a weekday (0 = Sunday … 6 = Saturday).
model ClinicSchedule {
  id        String   @id @default(cuid())
  clinicId  String
  dayOfWeek Int // 0..6
  openTime  String // "HH:mm"
  closeTime String // "HH:mm"
  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, dayOfWeek])
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Appointment {
  id                 String            @id @default(cuid())
  clinicId           String
  patientId          String
  startsAt           DateTime
  endsAt             DateTime
  reason             String?
  visitType          String?
  status             AppointmentStatus @default(SCHEDULED)
  cancelReason       String?
  // A walk-in is booked for "now", even outside clinic hours, and needs the
  // Doctor's approval, which is recorded here.
  walkIn             Boolean           @default(false)
  walkInApprovedById String?
  walkInApprovedAt   DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  clinic           Clinic             @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient          Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  walkInApprovedBy User?              @relation("WalkInApprovedBy", fields: [walkInApprovedById], references: [id], onDelete: Restrict)
  followUps        FollowUp[]
  events           AppointmentEvent[]
  images           ClinicalImage[]

  @@index([clinicId, startsAt])
  @@index([patientId, startsAt])
  @@index([status])
}

enum AppointmentAction {
  BOOKED
  RESCHEDULED
  CANCELLED
  STATUS_CHANGED
  WALK_IN_APPROVED
}

/// Append-only history of an appointment: the original booking is kept when
/// it is rescheduled or cancelled.
model AppointmentEvent {
  id            String            @id @default(cuid())
  appointmentId String
  action        AppointmentAction
  startsAt      DateTime // the time slot after this event
  endsAt        DateTime
  status        AppointmentStatus
  reason        String? // cancel reason
  actorId       String?
  at            DateTime          @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  actor       User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([appointmentId, at])
}

// =============================== Documents (Dev 1) ===========================

enum DocumentType {
  PRESCRIPTION
  MEDICAL_CERTIFICATE
}

enum DocumentRequestStatus {
  REQUESTED // logged by staff; the Doctor has not prepared it yet
  PENDING
  GENERATING
  READY
  FAILED
}

enum DocumentRequestChannel {
  PHONE
  IN_PERSON
  EMAIL
}

/// A document generation request. Rendering is handled by the Puppeteer service;
/// the resulting PDF is stored in S3 and linked via `Document`.
model DocumentRequest {
  id                     String                  @id @default(cuid())
  type                   DocumentType
  status                 DocumentRequestStatus   @default(PENDING)
  clinicId               String
  patientId              String
  requestedById          String?
  requestedVia           DocumentRequestChannel?
  notes                  String?
  payload                Json? // null until the Doctor prepares a REQUESTED document
  // Safety alerts (duplicate medicine, allergy) the Doctor acknowledged, with reasons.
  safetyAcknowledgements Json?
  error                  String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  clinic      Clinic    @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  requestedBy User?     @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  document    Document?

  @@index([status])
  @@index([patientId])
  @@index([clinicId])
}

enum DocumentSendChannel {
  EMAIL
  PRINT
}

/// A generated, stored document (PDF in S3).
model Document {
  id                String       @id @default(cuid())
  type              DocumentType
  clinicId          String
  patientId         String
  requestId         String       @unique
  storageKey        String // object key in the S3 bucket
  fileName          String
  mimeType          String       @default("application/pdf")
  sizeBytes         Int
  // Signed documents are locked; a change is issued as a new version.
  version           Int          @default(1)
  previousVersionId String?      @unique
  createdAt         DateTime     @default(now())

  signedById  String?
  signedAt    DateTime?
  sentById    String?
  sentAt      DateTime?
  sentVia     DocumentSendChannel?
  sentToEmail String?

  clinic          Clinic             @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient         Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  request         DocumentRequest    @relation(fields: [requestId], references: [id], onDelete: Restrict)
  signedBy        User?              @relation("DocumentSignedBy", fields: [signedById], references: [id], onDelete: Restrict)
  sentBy          User?              @relation("DocumentSentBy", fields: [sentById], references: [id], onDelete: Restrict)
  previousVersion Document?          @relation("DocumentVersions", fields: [previousVersionId], references: [id], onDelete: Restrict)
  nextVersion     Document?          @relation("DocumentVersions")
  deliveries      DocumentDelivery[]
  medications     Medication[]

  @@index([patientId])
  @@index([clinicId])
}

/// Every time a signed document was emailed or printed (Document.sent* holds the latest).
model DocumentDelivery {
  id         String              @id @default(cuid())
  documentId String
  via        DocumentSendChannel
  toEmail    String?
  messageId  String? // the mail server's id for an email
  sentById   String
  sentAt     DateTime            @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sentBy   User     @relation(fields: [sentById], references: [id], onDelete: Restrict)

  @@index([documentId, sentAt])
}

// ===================== Follow-up, consents, meds (Dev 3) =====================
//
// Per the Database Design doc (1.4.5, 1.4.13-1.4.16, 1.5): foreign keys are
// ON DELETE RESTRICT, clinical rows are never hard-deleted, and clinicId is set
// from the session's active clinic and never re-tagged. Encounter and
// IntakeSession tables do not exist yet; their optional FKs are added when
// those modules land.

enum ConsentType {
  DATA_PROCESSING
  REMINDER
}

enum ReminderChannel {
  SMS
  EMAIL
}

enum ConsentCaptureMethod {
  TABLET
  IN_PERSON
  STAFF_ENTRY
}

/// Evidence of a consent decision. Reminder consent is per channel; a consent
/// is "active" when granted and `withdrawnAt` is null.
model PatientConsent {
  id             String               @id @default(cuid())
  patientId      String
  consentType    ConsentType
  channel        ReminderChannel? // REMINDER consent only
  isGranted      Boolean
  captureMethod  ConsentCaptureMethod
  consentedAt    DateTime             @default(now())
  recordedById   String
  withdrawnAt    DateTime?
  withdrawnById  String?
  consentVersion String?

  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  recordedBy   User          @relation("ConsentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  withdrawnBy  User?         @relation("ConsentWithdrawnBy", fields: [withdrawnById], references: [id], onDelete: Restrict)
  outreachLogs OutreachLog[]

  @@index([patientId, consentType, channel])
}

enum FollowUpTaskType {
  FOLLOW_UP
  CHECK_UP
  LAB_TEST
  INJECTION
  PROCEDURE
}

enum FollowUpPriority {
  LOW
  NORMAL
  HIGH
}

enum FollowUpStatus {
  OPEN
  SCHEDULED
  COMPLETED
  DECLINED
  UNREACHABLE
}

/// A follow-up visit, check-up, lab test, injection or procedure a patient is
/// due for. `dueDate` is a clinic-local calendar date.
model FollowUp {
  id            String           @id @default(cuid())
  patientId     String
  clinicId      String
  appointmentId String?
  taskType      FollowUpTaskType
  reason        String
  dueDate       DateTime         @db.Date
  priority      FollowUpPriority @default(NORMAL)
  status        FollowUpStatus   @default(OPEN)
  recallRule    String?
  closureNote   String?
  createdById   String? // null when generated by a recall rule
  completedById String?
  completedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  appointment  Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  createdBy    User?         @relation("FollowUpCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  completedBy  User?         @relation("FollowUpCompletedBy", fields: [completedById], references: [id], onDelete: Restrict)
  outreachLogs OutreachLog[]

  @@index([clinicId, status, dueDate])
  @@index([patientId])
  @@index([appointmentId])
}

enum OutreachChannel {
  CALL
  SMS
  EMAIL
}

enum OutreachOutcome {
  REACHED
  NO_ANSWER
  LEFT_MESSAGE
  WRONG_NUMBER
  DECLINED
  BOOKED
  SENT
  FAILED
}

enum DeliveryStatus {
  DELIVERED
  FAILED
}

/// One contact attempt for a follow-up. Append-only: rows are never deleted and
/// only `deliveryStatus` may change (when the SMS/email service reports back).
model OutreachLog {
  id                String          @id @default(cuid())
  followUpId        String
  patientId         String
  clinicId          String
  consentId         String? // required for SMS and EMAIL
  channel           OutreachChannel
  attemptNumber     Int
  attemptedAt       DateTime        @default(now())
  outcome           OutreachOutcome
  patientResponse   String?
  providerMessageId String?
  deliveryStatus    DeliveryStatus?
  contactedById     String? // null for automated reminders

  followUp    FollowUp        @relation(fields: [followUpId], references: [id], onDelete: Restrict)
  patient     Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  clinic      Clinic          @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  consent     PatientConsent? @relation(fields: [consentId], references: [id], onDelete: Restrict)
  contactedBy User?           @relation(fields: [contactedById], references: [id], onDelete: Restrict)

  @@index([followUpId, attemptNumber])
  @@index([patientId])
  @@index([providerMessageId])
}

enum MedicationStatus {
  ACTIVE
  ON_HOLD
  DISCONTINUED
}

enum MedicationSource {
  PRESCRIBED_HERE
  PATIENT_REPORTED
  OTHER_DOCTOR
  OTC
}

/// Versioned medication entry. A change inserts a new row that supersedes the
/// earlier one (`isCurrent` flips to false); rows are never edited or deleted.
model Medication {
  id                     String           @id @default(cuid())
  patientId              String
  clinicId               String
  documentId             String?
  medicationName         String
  strength               String?
  dose                   String
  frequency              String
  route                  String
  instructions           String?
  indication             String?
  startDate              DateTime         @db.Date
  endDate                DateTime?        @db.Date
  status                 MedicationStatus @default(ACTIVE)
  discontinuationReason  String?
  prescribingDoctor      String
  source                 MedicationSource @default(PRESCRIBED_HERE)
  lookupVersion          Int?
  isCurrent              Boolean          @default(true)
  supersedesMedicationId String?          @unique
  recordedById           String
  recordedAt             DateTime         @default(now())

  patient      Patient     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  clinic       Clinic      @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  document     Document?   @relation(fields: [documentId], references: [id], onDelete: Restrict)
  recordedBy   User        @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  supersedes   Medication? @relation("MedicationVersions", fields: [supersedesMedicationId], references: [id], onDelete: Restrict)
  supersededBy Medication? @relation("MedicationVersions")

  @@index([patientId, isCurrent, status])
  @@index([clinicId])
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
}

/// A recorded allergy. Never hard-deleted: a removed entry is voided with a reason.
model Allergy {
  id            String           @id @default(cuid())
  patientId     String
  clinicId      String
  allergenName  String
  reaction      String?
  severity      AllergySeverity?
  lookupVersion Int?
  recordedById  String
  recordedAt    DateTime         @default(now())
  voidedAt      DateTime?
  voidReason    String?

  patient    Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  clinic     Clinic  @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  recordedBy User    @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([patientId, voidedAt])
}

// =============================== Audit Log (Dev 4) ===========================

/// Append-only audit log of every meaningful action in the system. Rows are
/// hash-chained for tamper-evidence (entryHash includes previousHash + content).
/// A Postgres trigger blocks UPDATE and DELETE at the DB level — even direct
/// SQL cannot rewrite history. User fields are snapshotted strings (not
/// foreign keys) so that deleting a user never removes their audit trail.
model AuditLog {
  id           String   @id @default(cuid())
  // Snapshot of the actor at the time of the event (null for pre-auth events
  // like failed logins against an unknown email).
  userId       String?
  userEmail    String?
  userRole     String?
  // What happened: a short constant like LOGIN_SUCCESS, LOGIN_FAILED,
  // USER_APPROVED, APPOINTMENT_CREATED. See src/audit/actions.ts for the list.
  action       String
  // The thing it happened to.
  resourceType String?
  resourceId   String?
  // HTTP context (null for background jobs).
  method       String?
  path         String?
  statusCode   Int?
  ipAddress    String?
  userAgent    String?
  // Optional per-event detail payload.
  metadata     Json?
  createdAt    DateTime @default(now())
  // Hash chain: entryHash = sha256(previousHash + canonicalContent). The first
  // row's previousHash is the empty string.
  previousHash String
  entryHash    String   @unique

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

// ============================= Clinical Images (Dev 4) =======================

/// Soft-delete status for ClinicalImage. Hard delete would compromise the
/// audit trail; a DELETED row stays in the DB but is hidden from normal reads.
enum ImageStatus {
  ACTIVE
  DELETED
}

/// A clinical image uploaded by a Doctor for a patient, optionally tied to a
/// specific appointment (visit). The bytes live in S3-compatible storage under
/// `storageKey`; only the Doctor's object-storage client ever sees them in the
/// clear (server-side encryption is applied on upload).
model ClinicalImage {
  id            String  @id @default(cuid())
  patientId     String
  appointmentId String?
  uploadedById  String?
  // S3 object key, unique across the bucket.
  storageKey    String  @unique
  fileName      String
  mimeType      String
  sizeBytes     Int

  /// @encrypted
  caption String?

  status    ImageStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  patient     Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment Appointment?      @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  uploadedBy  User?             @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  annotations ImageAnnotation[]

  @@index([patientId, createdAt])
  @@index([appointmentId])
  @@index([status])
}

/// A versioned Konva drawing/annotation layer over a ClinicalImage. Saves are
/// append-only: a new save creates a new row with the next `version` number,
/// so the previous layer stays in the DB and can be audited or restored.
model ImageAnnotation {
  id              String   @id @default(cuid())
  clinicalImageId String
  createdById     String?
  version         Int      @default(1)
  // Full Konva stage JSON (strokes, text, shapes, their styling).
  konvaData       Json
  createdAt       DateTime @default(now())

  clinicalImage ClinicalImage @relation(fields: [clinicalImageId], references: [id], onDelete: Cascade)
  createdBy     User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([clinicalImageId, version])
  @@index([clinicalImageId, createdAt])
}

// ============================= Tablet Intake (Dev 4) =========================

/// Lifecycle of a supervised intake session on a shared clinic tablet. A
/// session is one-shot: after submit it moves to SUBMITTED and the token
/// no longer accepts further input. The next patient needs a fresh session.
enum TabletIntakeStatus {
  ACTIVE
  SUBMITTED
  CANCELLED
  EXPIRED
}

/// A supervised intake handover. The Secretary starts it on a tablet, hands
/// the tablet to the patient, and the patient fills the form. The token is
/// a random opaque string the tablet sends on each request so the patient
/// never signs in.
model TabletIntakeSession {
  id                   String             @id @default(cuid())
  clinicId             String
  startedBySecretaryId String?
  // High-entropy opaque token (base64url of 32 random bytes). Kept unique so
  // leaked tokens cannot collide with newly minted ones.
  token                String             @unique
  status               TabletIntakeStatus @default(ACTIVE)
  expiresAt            DateTime
  createdAt            DateTime           @default(now())
  submittedAt          DateTime?
  cancelledAt          DateTime?

  clinic             Clinic                  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  startedBySecretary User?                   @relation("TabletIntakeSessionStarter", fields: [startedBySecretaryId], references: [id], onDelete: SetNull)
  submission         TabletIntakeSubmission?

  @@index([status])
  @@index([clinicId, createdAt])
}

/// The one-and-only form submission for a given session. Linked to the Patient
/// the session resolved to (either dedup-matched or newly created on submit).
model TabletIntakeSubmission {
  id         String   @id @default(cuid())
  sessionId  String   @unique
  patientId  String
  // Full form payload as submitted (personal info, med history, consents).
  rawPayload Json
  createdAt  DateTime @default(now())

  session TabletIntakeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  patient Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

// ============================= User <-> Clinic (Dev 4) =======================

/// Many-to-many assignment of users to clinics. A user can only act on data
/// scoped to a clinic they are assigned to (QA 3). The Doctor is typically
/// assigned to all clinics they own; Secretaries are assigned to one or more
/// clinics they staff.
model UserClinic {
  userId     String
  clinicId   String
  assignedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@id([userId, clinicId])
  @@index([userId])
  @@index([clinicId])
}
