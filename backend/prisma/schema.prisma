// Prisma schema — clinic management system.
//
// Developer 1 owns: Clinic, ClinicSchedule, Appointment, Document, DocumentRequest.
// Developer 2 owns: Patient (full model below).
// User (Dev 4) is still a placeholder; keep its `id` stable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================ Patients (Dev 2) ===============================

enum Sex {
  MALE
  FEMALE
}

/// Shared patient chart (data dictionary 1.4.4).
///
/// Fields commented "app-encrypted" hold AES-256-GCM ciphertext written by
/// src/lib/fieldCrypto.ts, never plaintext. Do NOT add the prisma-field-encryption
/// tag to these fields, or they will be encrypted twice. Because ciphertext cannot be
/// searched, each searchable field also has a keyed HMAC "blind index"
/// (*Idx columns). Search and duplicate detection run on those indexes.
/// Blind indexes support exact matches only (after normalisation), not
/// partial matches.
model Patient {
  id                 String @id @default(cuid())
  /// Sequential number shown as "P-00231". Never reused.
  patientSeq         Int    @unique @default(autoincrement())
  registeredClinicId String

  firstName   String // app-encrypted
  middleName  String? // app-encrypted
  lastName    String // app-encrypted
  dateOfBirth String // app-encrypted (ISO date "YYYY-MM-DD")
  sex         Sex
  civilStatus String?
  occupation  String? // app-encrypted

  mobileNumber          String // app-encrypted
  alternatePhone        String? // app-encrypted
  email                 String? // app-encrypted
  address               String? // app-encrypted
  emergencyContactName  String? // app-encrypted
  emergencyContactPhone String? // app-encrypted

  hmoProvider      String?
  hmoMemberNumber  String? // app-encrypted
  hmoValidUntil    DateTime? @db.Date
  philhealthNumber String? // app-encrypted
  referralSource   String?

  /// Doctor-only, from supervised intake.
  medicalHistory    String? // app-encrypted
  ophthalmicHistory String? // app-encrypted

  // Blind indexes (HMAC-SHA256 hex of the normalised value)
  firstNameIdx String
  lastNameIdx  String
  dobIdx       String
  mobileIdx    String

  voidedAt    DateTime?
  voidReason  String?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  registeredClinic Clinic @relation("PatientRegisteredClinic", fields: [registeredClinicId], references: [id], onDelete: Restrict)
  createdBy        User   @relation("PatientCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  appointments     Appointment[]
  documents        Document[]
  documentRequests DocumentRequest[]
  consents         PatientConsent[]
  followUps        FollowUp[]
  outreachLogs     OutreachLog[]
  medications      Medication[]
  allergies        Allergy[]
  encounters       Encounter[]
  examFindings     ExamFinding[]
  labResults       LabResult[]

  @@index([lastNameIdx])
  @@index([firstNameIdx])
  @@index([dobIdx, lastNameIdx])
  @@index([mobileIdx])
  @@index([registeredClinicId])
}

// ============ Encounters, clinical notes, findings and lab results (Dev 2) ===

enum EncounterType {
  NEW_PATIENT
  FOLLOW_UP
  PROCEDURE
  WALK_IN
}

/// OPEN until the primary note is signed, then SIGNED (set by a database
/// trigger in the same statement that signs the note).
enum EncounterStatus {
  OPEN
  SIGNED
}

enum NoteType {
  PRIMARY
  ADDENDUM
}

enum NoteStatus {
  DRAFT
  SIGNED
}

/// OU is accepted only for fields that are measured with both eyes together.
enum Eye {
  OD
  OS
  OU
}

/// One patient visit at one clinic (S06 visit list, S07 header).
/// Holds at most one PRIMARY note, plus dated addenda once that note is signed.
model Encounter {
  id                String          @id @default(cuid())
  patientId         String
  clinicId          String
  /// Set when the visit came from a booked appointment. One encounter per appointment.
  appointmentId     String?         @unique
  attendingDoctorId String
  type              EncounterType
  /// Clinic-local date of the visit, used for chart lists and comparisons.
  visitDate         DateTime        @db.Date
  visitStartedAt    DateTime        @default(now())
  /// Set when the primary note is signed.
  visitEndedAt      DateTime?
  status            EncounterStatus @default(OPEN)
  createdById       String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  patient         Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  clinic          Clinic         @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  appointment     Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  attendingDoctor User           @relation("EncounterAttendingDoctor", fields: [attendingDoctorId], references: [id], onDelete: Restrict)
  createdBy       User           @relation("EncounterCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  notes           ClinicalNote[]
  examFindings    ExamFinding[]
  labResults      LabResult[]

  @@index([patientId, visitDate])
  @@index([clinicId, visitDate])
}

/// Consultation note (S07) or a dated addendum to it.
///
/// PRIMARY: one per encounter (partial unique index in the migration). Editable
/// while DRAFT; signing sets SIGNED and locks it.
/// ADDENDUM: points at the signed PRIMARY through parentNoteId, needs an
/// addendumReason, and is inserted already SIGNED.
///
/// Database triggers (see the encounters migration) reject any UPDATE or
/// DELETE of a SIGNED row, and addenda on unsigned notes.
model ClinicalNote {
  id           String     @id @default(cuid())
  encounterId  String
  noteType     NoteType   @default(PRIMARY)
  parentNoteId String?
  status       NoteStatus @default(DRAFT)
  /// Bumped on every save. Clients send it back so a stale autosave cannot
  /// overwrite newer text, and so the doctor signs exactly what they saw.
  version      Int        @default(1)

  chiefComplaint String? // app-encrypted
  subjective     String? // app-encrypted
  objective      String? // app-encrypted
  assessment     String? // app-encrypted
  plan           String? // app-encrypted
  // app-encrypted JSON: [{ code?, label, eye? }]
  diagnosisItems String?
  addendumReason String? @db.VarChar(500)

  authorId    String
  signedById  String?
  signedAt    DateTime?
  /// SHA-256 over the plaintext content and signature at signing time, so a
  /// later change to the stored ciphertext can be detected.
  contentHash String?   @db.Char(64)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  encounter  Encounter      @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  parentNote ClinicalNote?  @relation("NoteAddenda", fields: [parentNoteId], references: [id], onDelete: Restrict)
  addenda    ClinicalNote[] @relation("NoteAddenda")
  author     User           @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  signedBy   User?          @relation("NoteSignedBy", fields: [signedById], references: [id], onDelete: Restrict)

  @@index([encounterId])
  @@index([parentNoteId, signedAt])
  @@index([status])
}

/// One eye-specific measurement (S07 examination table, S08 comparison).
/// Editable while the encounter is OPEN. Once the primary note is signed the
/// rows are locked; a correction is a new row with amendsFindingId set.
model ExamFinding {
  id              String   @id @default(cuid())
  patientId       String
  encounterId     String
  clinicId        String
  eye             Eye
  /// Comparison field key, e.g. VA, IOP (see EXAM_FIELDS in @clinic/schemas).
  fieldName       String   @db.VarChar(100)
  valueText       String // app-encrypted
  unit            String?  @db.VarChar(30)
  method          String?  @db.VarChar(100)
  measuredAt      DateTime
  /// Derived from visual acuity so different notations can be compared.
  logmarValue     Decimal? @db.Decimal(6, 3)
  lookupVersion   Int
  amendsFindingId String?
  amendmentReason String?  @db.VarChar(500)
  recordedById    String
  recordedAt      DateTime @default(now())

  patient    Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter  Encounter     @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  clinic     Clinic        @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  amends     ExamFinding?  @relation("FindingAmendments", fields: [amendsFindingId], references: [id], onDelete: Restrict)
  amendedBy  ExamFinding[] @relation("FindingAmendments")
  recordedBy User          @relation("FindingRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([patientId, fieldName])
  @@index([encounterId])
  @@index([amendsFindingId])
}

/// Laboratory or diagnostic result, usually from an outside laboratory (S08
/// "Add Lab Result"). Insert-only: a correction is a new row with
/// amendsLabResultId set, and the original stays in the history.
model LabResult {
  id                String   @id @default(cuid())
  patientId         String
  /// Optional: patients often bring results that are not tied to a visit.
  encounterId       String?
  clinicId          String
  testName          String   @db.VarChar(100)
  resultValue       String // app-encrypted
  resultUnit        String   @db.VarChar(20)
  referenceRange    String?  @db.VarChar(50)
  /// Computed from referenceRange when the value and range are numeric.
  outOfRange        Boolean  @default(false)
  /// Specimen date; never in the future. Results are ordered by this date.
  collectionDate    DateTime @db.Date
  laboratoryName    String   @db.VarChar(150)
  /// Object key of the scanned report in the encrypted document store.
  reportFileRef     String?  @db.VarChar(255)
  lookupVersion     Int
  amendsLabResultId String?
  amendmentReason   String?  @db.VarChar(500)
  recordedById      String
  recordedAt        DateTime @default(now())

  patient    Patient     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter  Encounter?  @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  clinic     Clinic      @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  amends     LabResult?  @relation("LabResultAmendments", fields: [amendsLabResultId], references: [id], onDelete: Restrict)
  amendedBy  LabResult[] @relation("LabResultAmendments")
  recordedBy User        @relation("LabResultRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([patientId, testName, collectionDate])
  @@index([encounterId])
  @@index([amendsLabResultId])
}

/// Staff account. Only the Doctor can approve, change, revoke accounts and the
/// clinics each account may work in (see UserClinic).
model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  fullName            String
  passwordHash        String
  role                UserRole   @default(SECRETARY)
  status              UserStatus @default(PENDING)
  // Lockout tracking per SRS 7.2: 5 failed attempts within 15 min locks the account.
  failedLoginAttempts Int        @default(0)
  firstFailedLoginAt  DateTime?
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  documentRequests DocumentRequest[]
  documentsSigned  Document[]        @relation("DocumentSignedBy")
  documentsSent    Document[]        @relation("DocumentSentBy")

  consentsRecorded    PatientConsent[] @relation("ConsentRecordedBy")
  consentsWithdrawn   PatientConsent[] @relation("ConsentWithdrawnBy")
  followUpsCreated    FollowUp[]       @relation("FollowUpCreatedBy")
  followUpsCompleted  FollowUp[]       @relation("FollowUpCompletedBy")
  outreachLogs        OutreachLog[]
  medicationsRecorded Medication[]
  allergiesRecorded   Allergy[]
  patientsCreated     Patient[]        @relation("PatientCreatedBy")
  encountersCreated   Encounter[]      @relation("EncounterCreatedBy")
  notesAuthored       ClinicalNote[]   @relation("NoteAuthor")
  notesSigned         ClinicalNote[]   @relation("NoteSignedBy")
  encountersAttended  Encounter[]      @relation("EncounterAttendingDoctor")
  findingsRecorded    ExamFinding[]    @relation("FindingRecordedBy")
  labResultsRecorded  LabResult[]      @relation("LabResultRecordedBy")

  @@index([status])
  @@index([role])
}

enum UserRole {
  DOCTOR
  SECRETARY
}

enum UserStatus {
  PENDING
  ACTIVE
  LOCKED
  REVOKED
}

// ================================ Clinic (Dev 1) =============================

model Clinic {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  email     String?
  timezone  String   @default("Asia/Manila")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedules          ClinicSchedule[]
  appointments       Appointment[]
  documents          Document[]
  documentRequests   DocumentRequest[]
  followUps          FollowUp[]
  outreachLogs       OutreachLog[]
  medications        Medication[]
  allergies          Allergy[]
  patientsRegistered Patient[]         @relation("PatientRegisteredClinic")
  encounters         Encounter[]
  examFindings       ExamFinding[]
  labResults         LabResult[]

  @@index([isActive])
}

/// One operating-hours window for a clinic on a weekday (0 = Sunday … 6 = Saturday).
model ClinicSchedule {
  id        String   @id @default(cuid())
  clinicId  String
  dayOfWeek Int // 0..6
  openTime  String // "HH:mm"
  closeTime String // "HH:mm"
  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, dayOfWeek])
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Appointment {
  id        String            @id @default(cuid())
  clinicId  String
  patientId String
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  status    AppointmentStatus @default(SCHEDULED)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  clinic    Clinic     @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  followUps FollowUp[]
  encounter Encounter?

  @@index([clinicId, startsAt])
  @@index([patientId, startsAt])
  @@index([status])
}

// =============================== Documents (Dev 1) ===========================

enum DocumentType {
  PRESCRIPTION
  MEDICAL_CERTIFICATE
}

enum DocumentRequestStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

/// A document generation request. Rendering is handled by the Puppeteer service;
/// the resulting PDF is stored in S3 and linked via `Document`.
model DocumentRequest {
  id            String                @id @default(cuid())
  type          DocumentType
  status        DocumentRequestStatus @default(PENDING)
  clinicId      String
  patientId     String
  requestedById String?
  payload       Json
  error         String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  clinic      Clinic    @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  requestedBy User?     @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  document    Document?

  @@index([status])
  @@index([patientId])
  @@index([clinicId])
}

enum DocumentSendChannel {
  EMAIL
  PRINT
}

/// A generated, stored document (PDF in S3).
model Document {
  id         String       @id @default(cuid())
  type       DocumentType
  clinicId   String
  patientId  String
  requestId  String       @unique
  storageKey String // object key in the S3 bucket
  fileName   String
  mimeType   String       @default("application/pdf")
  sizeBytes  Int
  createdAt  DateTime     @default(now())

  signedById  String?
  signedAt    DateTime?
  sentById    String?
  sentAt      DateTime?
  sentVia     DocumentSendChannel?
  sentToEmail String?

  clinic      Clinic          @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient     Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  request     DocumentRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  signedBy    User?           @relation("DocumentSignedBy", fields: [signedById], references: [id], onDelete: Restrict)
  sentBy      User?           @relation("DocumentSentBy", fields: [sentById], references: [id], onDelete: Restrict)
  medications Medication[]

  @@index([patientId])
  @@index([clinicId])
}

// ===================== Follow-up, consents, meds (Dev 3) =====================
//
// Per the Database Design doc (1.4.5, 1.4.13-1.4.16, 1.5): foreign keys are
// ON DELETE RESTRICT, clinical rows are never hard-deleted, and clinicId is set
// from the session's active clinic and never re-tagged. Encounter and
// IntakeSession tables do not exist yet; their optional FKs are added when
// those modules land.

enum ConsentType {
  DATA_PROCESSING
  REMINDER
}

enum ReminderChannel {
  SMS
  EMAIL
}

enum ConsentCaptureMethod {
  TABLET
  IN_PERSON
  STAFF_ENTRY
}

/// Evidence of a consent decision. Reminder consent is per channel; a consent
/// is "active" when granted and `withdrawnAt` is null.
model PatientConsent {
  id             String               @id @default(cuid())
  patientId      String
  consentType    ConsentType
  channel        ReminderChannel? // REMINDER consent only
  isGranted      Boolean
  captureMethod  ConsentCaptureMethod
  consentedAt    DateTime             @default(now())
  recordedById   String
  withdrawnAt    DateTime?
  withdrawnById  String?
  consentVersion String?

  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  recordedBy   User          @relation("ConsentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  withdrawnBy  User?         @relation("ConsentWithdrawnBy", fields: [withdrawnById], references: [id], onDelete: Restrict)
  outreachLogs OutreachLog[]

  @@index([patientId, consentType, channel])
}

enum FollowUpTaskType {
  FOLLOW_UP
  CHECK_UP
  LAB_TEST
  INJECTION
  PROCEDURE
}

enum FollowUpPriority {
  LOW
  NORMAL
  HIGH
}

enum FollowUpStatus {
  OPEN
  SCHEDULED
  COMPLETED
  DECLINED
  UNREACHABLE
}

/// A follow-up visit, check-up, lab test, injection or procedure a patient is
/// due for. `dueDate` is a clinic-local calendar date.
model FollowUp {
  id            String           @id @default(cuid())
  patientId     String
  clinicId      String
  appointmentId String?
  taskType      FollowUpTaskType
  reason        String
  dueDate       DateTime         @db.Date
  priority      FollowUpPriority @default(NORMAL)
  status        FollowUpStatus   @default(OPEN)
  recallRule    String?
  closureNote   String?
  createdById   String? // null when generated by a recall rule
  completedById String?
  completedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  appointment  Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  createdBy    User?         @relation("FollowUpCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  completedBy  User?         @relation("FollowUpCompletedBy", fields: [completedById], references: [id], onDelete: Restrict)
  outreachLogs OutreachLog[]

  @@index([clinicId, status, dueDate])
  @@index([patientId])
  @@index([appointmentId])
}

enum OutreachChannel {
  CALL
  SMS
  EMAIL
}

enum OutreachOutcome {
  REACHED
  NO_ANSWER
  LEFT_MESSAGE
  WRONG_NUMBER
  DECLINED
  BOOKED
  SENT
  FAILED
}

enum DeliveryStatus {
  DELIVERED
  FAILED
}

/// One contact attempt for a follow-up. Append-only: rows are never deleted and
/// only `deliveryStatus` may change (when the SMS/email service reports back).
model OutreachLog {
  id                String          @id @default(cuid())
  followUpId        String
  patientId         String
  clinicId          String
  consentId         String? // required for SMS and EMAIL
  channel           OutreachChannel
  attemptNumber     Int
  attemptedAt       DateTime        @default(now())
  outcome           OutreachOutcome
  patientResponse   String?
  providerMessageId String?
  deliveryStatus    DeliveryStatus?
  contactedById     String? // null for automated reminders

  followUp    FollowUp        @relation(fields: [followUpId], references: [id], onDelete: Restrict)
  patient     Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  clinic      Clinic          @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  consent     PatientConsent? @relation(fields: [consentId], references: [id], onDelete: Restrict)
  contactedBy User?           @relation(fields: [contactedById], references: [id], onDelete: Restrict)

  @@index([followUpId, attemptNumber])
  @@index([patientId])
  @@index([providerMessageId])
}

enum MedicationStatus {
  ACTIVE
  ON_HOLD
  DISCONTINUED
}

enum MedicationSource {
  PRESCRIBED_HERE
  PATIENT_REPORTED
  OTHER_DOCTOR
  OTC
}

/// Versioned medication entry. A change inserts a new row that supersedes the
/// earlier one (`isCurrent` flips to false); rows are never edited or deleted.
model Medication {
  id                     String           @id @default(cuid())
  patientId              String
  clinicId               String
  documentId             String?
  medicationName         String
  strength               String?
  dose                   String
  frequency              String
  route                  String
  instructions           String?
  indication             String?
  startDate              DateTime         @db.Date
  endDate                DateTime?        @db.Date
  status                 MedicationStatus @default(ACTIVE)
  discontinuationReason  String?
  prescribingDoctor      String
  source                 MedicationSource @default(PRESCRIBED_HERE)
  lookupVersion          Int?
  isCurrent              Boolean          @default(true)
  supersedesMedicationId String?          @unique
  recordedById           String
  recordedAt             DateTime         @default(now())

  patient      Patient     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  clinic       Clinic      @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  document     Document?   @relation(fields: [documentId], references: [id], onDelete: Restrict)
  recordedBy   User        @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  supersedes   Medication? @relation("MedicationVersions", fields: [supersedesMedicationId], references: [id], onDelete: Restrict)
  supersededBy Medication? @relation("MedicationVersions")

  @@index([patientId, isCurrent, status])
  @@index([clinicId])
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
}

/// A recorded allergy. Never hard-deleted: a removed entry is voided with a reason.
model Allergy {
  id            String           @id @default(cuid())
  patientId     String
  clinicId      String
  allergenName  String
  reaction      String?
  severity      AllergySeverity?
  lookupVersion Int?
  recordedById  String
  recordedAt    DateTime         @default(now())
  voidedAt      DateTime?
  voidReason    String?

  patient    Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  clinic     Clinic  @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  recordedBy User    @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([patientId, voidedAt])
}
