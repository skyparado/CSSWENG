diff --git a/frontend/src/styles.css b/frontend/src/styles.css
index c0f77ec..99aa555 100644
--- a/frontend/src/styles.css
+++ b/frontend/src/styles.css
@@ -134,9 +134,18 @@ button.link { border: 0; background: none; padding: 4px 0; color: var(--navy); }
 .alert.duplicate .row + .row { margin-top: 8px; }
 .alert.allergy { color: var(--red); margin: 16px 0; }
 .notice { margin: 16px 0; }
-.patient-head { display: flex; align-items: center; gap: 20px; margin-bottom: 16px; }
-.patient-head h1 { font-size: 26px; }
+.patient-head { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; margin-bottom: 16px; }
+.patient-head h1 { font-size: 26px; margin: 0; }
 .patient-head p { margin: 4px 0 0; }
+/* The name and identifiers keep a readable width; below it the action buttons
+   wrap to their own line instead of crushing the text (APP DEV Nov 10 — the
+   S06/S07/S08 header was cramped in the two-column split view). */
+.patient-head > .grow { flex: 1 1 240px; min-width: 0; }
+.patient-head > .row { flex: 0 0 auto; margin-left: auto; }
+@media (max-width: 640px) {
+  .patient-head h1 { font-size: 22px; }
+  .patient-head > .row { margin-left: 0; width: 100%; }
+}
 .avatar { width: 64px; height: 64px; border-radius: 50%; background: #eaf1fb; color: var(--navy); font-weight: 700; font-size: 22px; display: grid; place-items: center; flex: none; }
 .tabs { display: flex; gap: 4px; border-bottom: 1px solid var(--line); margin: 8px 0 20px; }
 .tabs button { border: 0; border-bottom: 3px solid transparent; border-radius: 0; background: none; color: var(--muted); padding: 10px 16px; }
